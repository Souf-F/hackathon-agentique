# ============================================
# LA TAUPE — exemple de configuration
# Copier en local :  cp .env.example .env
# Ne jamais committer .env
# ============================================

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend
FRONTEND_URL=http://localhost:5173

# Fournisseur de modèle
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# Base de données
DATABASE_URL=sqlite:///./data/la-taupe.db

# Retrieval
RETRIEVAL_TOP_K=5

# Détection
INJECTION_CONFIDENCE_THRESHOLD=0.80
