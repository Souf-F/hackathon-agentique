# ============================================
# LA TAUPE — exemple de configuration
# Copier en local :  cp .env.example .env
# Ne jamais committer .env
#
# Seules les variables ci-dessous sont effectivement lues par le code
# (vérifié dans backend/*.py — grep os.environ / os.getenv).
# ============================================

# Fournisseur de modèle (backend/answer.py) — optionnel : sans clé, mode extractif
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Base de données (backend/db.py)
DATABASE_URL=sqlite:///./data/la-taupe.db

# Détection (backend/pipeline.py)
INJECTION_CONFIDENCE_THRESHOLD=0.5
